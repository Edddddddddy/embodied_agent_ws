+std::vector<bool> FrontierSearch::clearanceReachableFrom(
+    unsigned int start, const geometry_msgs::msg::Point& robot_position,
+    const std::vector<bool>& reachable_flag,
+    const std::vector<bool>& clearance_safe_flag)
+{
+  if (approach_clearance_ <= 0.0) {
+    last_clearance_domain_valid_ = true;
+    return reachable_flag;
+  }
+
+  std::vector<bool> clearance_reachable(size_x_ * size_y_, false);
+  std::vector<bool> seed_seen(size_x_ * size_y_, false);
+  std::queue<unsigned int> seed_search;
+  std::vector<unsigned int> nearest_candidates;
+  seed_search.push(start);
+  seed_seen[start] = true;
+
+  // 刚扩展的 unknown 可能暂时贴近机器人，使起点本身不满足 clearance。
+  // 只允许在显式半径内寻找唯一最近 anchor；同时播种多个安全分量会把窄门
+  // 两侧错误合并，而全图 nearest 又会把远端房间伪装成机器人可达。
+  const std::size_t max_seed_layers = static_cast<std::size_t>(std::ceil(
+      robot_anchor_max_distance_ / costmap_->getResolution()));
+  for (std::size_t layer = 0;
+       !seed_search.empty() && nearest_candidates.empty() &&
+       layer <= max_seed_layers;
+       ++layer) {
+    const std::size_t layer_size = seed_search.size();
+    for (std::size_t offset = 0; offset < layer_size; ++offset) {
+      const unsigned int index = seed_search.front();
+      seed_search.pop();
+      if (clearance_safe_flag[index]) {
+        nearest_candidates.push_back(index);
+        continue;
+      }
+      if (layer == max_seed_layers) {
+        continue;
+      }
+      for (const unsigned int neighbour : nhood4(index, *costmap_)) {
+        if (reachable_flag[neighbour] && !seed_seen[neighbour]) {
+          seed_seen[neighbour] = true;
+          seed_search.push(neighbour);
+        }
+      }
+    }
+  }
+
+  if (nearest_candidates.empty()) {
+    return clearance_reachable;
+  }
+  const auto anchor = *std::min_element(
+      nearest_candidates.begin(), nearest_candidates.end(),
+      [this, &robot_position](unsigned int lhs, unsigned int rhs) {
+        const auto distance_squared = [this, &robot_position](unsigned int index) {
+          unsigned int cell_x, cell_y;
+          double world_x, world_y;
+          costmap_->indexToCells(index, cell_x, cell_y);
+          costmap_->mapToWorld(cell_x, cell_y, world_x, world_y);
+          const double dx = world_x - robot_position.x;
+          const double dy = world_y - robot_position.y;
+          return dx * dx + dy * dy;
+        };
+        const double lhs_distance = distance_squared(lhs);
+        const double rhs_distance = distance_squared(rhs);
+        if (std::abs(lhs_distance - rhs_distance) > 1e-12) {
+          return lhs_distance < rhs_distance;
+        }
+        return lhs < rhs;
+      });
+  last_clearance_domain_valid_ = true;
+
+  std::queue<unsigned int> safe_bfs;
+  clearance_reachable[anchor] = true;
+  safe_bfs.push(anchor);
+  while (!safe_bfs.empty()) {
+    const unsigned int index = safe_bfs.front();
+    safe_bfs.pop();
+    for (const unsigned int neighbour : nhood4(index, *costmap_)) {
+      if (!reachable_flag[neighbour] || clearance_reachable[neighbour] ||
+          !clearance_safe_flag[neighbour]) {
+        continue;
+      }
+      clearance_reachable[neighbour] = true;
+      safe_bfs.push(neighbour);
+    }
+  }
+  return clearance_reachable;
+}
+
+std::vector<bool> FrontierSearch::clearanceSafeMask(
+    const std::vector<bool>& reachable_flag) const
+{
+  if (approach_clearance_ <= 0.0) {
+    return reachable_flag;
+  }
+  std::vector<bool> safe(size_x_ * size_y_, false);
+  for (std::size_t index = 0; index < safe.size(); ++index) {
+    if (reachable_flag[index] &&
+        approachCellHasClearance(static_cast<unsigned int>(index))) {
+      safe[index] = true;
+    }
+  }
+  return safe;
+}
