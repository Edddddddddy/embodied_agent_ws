+TEST(FrontierSearch, neverSelectsLocallySafeGoalBehindNarrowPassage)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      24, 15, 0.1, 0.0, 0.0, LETHAL_OBSTACLE);
+  for (unsigned int y = 2; y <= 12; ++y) {
+    for (unsigned int x = 1; x <= 8; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+    for (unsigned int x = 15; x <= 20; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+    costmap.setCost(21, y, NO_INFORMATION);
+  }
+  // 两个宽房间之间只有 0.30m 的点机器人通道。右侧 approach 局部有
+  // 0.22m clearance，但完整 footprint 无法从左侧机器人位置穿过通道。
+  for (unsigned int y = 6; y <= 8; ++y) {
+    for (unsigned int x = 9; x <= 14; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+  }
+
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"),
+      0.22, 1.5);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(3, 7, robot.x, robot.y);
+  const auto frontiers = search.searchFrom(robot);
+
+  // 右侧房间的点局部安全，但不属于机器人的 clearance-safe 连通域；如果
+  // 还能从左侧安全位置观察该 frontier，可以退让到左侧，但绝不能发右侧点。
+  ASSERT_FALSE(frontiers.empty());
+  ASSERT_TRUE(std::any_of(
+      frontiers.begin(), frontiers.end(),
+      [](const auto& frontier) { return frontier.has_approach; }));
+  for (const auto& frontier : frontiers) {
+    if (!frontier.has_approach) {
+      continue;
+    }
+    unsigned int approach_x, approach_y;
+    ASSERT_TRUE(costmap.worldToMap(
+        frontier.approach.x, frontier.approach.y, approach_x, approach_y));
+    EXPECT_LE(approach_x, 8u);
+  }
+}
