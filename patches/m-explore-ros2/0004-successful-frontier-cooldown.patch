@@ -0,0 +1,93 @@
+#ifndef EXPLORE_FRONTIER_GOAL_COOLDOWN_H_
+#define EXPLORE_FRONTIER_GOAL_COOLDOWN_H_
+
+#include <geometry_msgs/msg/point.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <cmath>
+#include <vector>
+
+namespace explore
+{
+
+/**
+ * @brief 成功 frontier 的短期去重账本。
+ *
+ * Nav2 到达 approach 后，SLAM/map_updates 需要时间消化新激光。账本只在短期
+ * 跳过同一 frontier，既避免“立即成功”目标风暴，也不会像永久黑名单那样
+ * 掩盖尚未完成的 unknown 区域。
+ */
+class FrontierGoalCooldown
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  using TimePoint = Clock::time_point;
+
+  void record(const geometry_msgs::msg::Point& goal, TimePoint now,
+              double cooldown_seconds, double tolerance_m)
+  {
+    prune(now);
+    const auto expires_at = now +
+        std::chrono::duration_cast<Clock::duration>(
+            std::chrono::duration<double>(cooldown_seconds));
+    for (auto& entry : entries_) {
+      if (near(entry.goal, goal, tolerance_m)) {
+        entry.goal = goal;
+        entry.expires_at = expires_at;
+        return;
+      }
+    }
+    entries_.push_back({goal, expires_at});
+  }
+
+  bool contains(const geometry_msgs::msg::Point& goal, TimePoint now,
+                double tolerance_m)
+  {
+    prune(now);
+    for (const auto& entry : entries_) {
+      if (near(entry.goal, goal, tolerance_m)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void clear() { entries_.clear(); }
+  std::size_t size() const { return entries_.size(); }
+
+private:
+  struct Entry
+  {
+    geometry_msgs::msg::Point goal;
+    TimePoint expires_at;
+  };
+
+  static bool near(const geometry_msgs::msg::Point& left,
+                   const geometry_msgs::msg::Point& right,
+                   double tolerance_m)
+  {
+    return std::abs(left.x - right.x) < tolerance_m &&
+           std::abs(left.y - right.y) < tolerance_m;
+  }
+
+  void prune(TimePoint now)
+  {
+    auto output = entries_.begin();
+    for (auto input = entries_.begin(); input != entries_.end(); ++input) {
+      if (input->expires_at > now) {
+        if (output != input) {
+          *output = *input;
+        }
+        ++output;
+      }
+    }
+    entries_.erase(output, entries_.end());
+  }
+
+  std::vector<Entry> entries_;
+};
+
+}  // namespace explore
+
+#endif  // EXPLORE_FRONTIER_GOAL_COOLDOWN_H_
