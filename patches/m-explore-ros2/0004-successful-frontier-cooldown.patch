+TEST(FrontierGoalCooldown, skipsReachedGoalUntilCooldownExpires)
+{
+  explore::FrontierGoalCooldown cooldown;
+  geometry_msgs::msg::Point reached;
+  reached.x = 1.0;
+  reached.y = 2.0;
+  geometry_msgs::msg::Point nearby = reached;
+  nearby.x += 0.1;
+  geometry_msgs::msg::Point other = reached;
+  other.x += 1.0;
+  const auto now = explore::FrontierGoalCooldown::Clock::now();
+
+  cooldown.record(reached, now, 15.0, 0.25);
+
+  EXPECT_TRUE(cooldown.contains(reached, now, 0.25));
+  EXPECT_TRUE(cooldown.contains(nearby, now, 0.25));
+  EXPECT_FALSE(cooldown.contains(other, now, 0.25));
+  EXPECT_EQ(cooldown.size(), 1u);
+  EXPECT_FALSE(cooldown.contains(
+      reached, now + std::chrono::seconds(16), 0.25));
+  EXPECT_EQ(cooldown.size(), 0u);
+}
+
+TEST(FrontierGoalCooldown, refreshesNearbyIdentityWithoutGrowingLedger)
+{
+  explore::FrontierGoalCooldown cooldown;
+  geometry_msgs::msg::Point first;
+  first.x = 1.0;
+  geometry_msgs::msg::Point shifted = first;
+  shifted.x = 1.1;
+  const auto now = explore::FrontierGoalCooldown::Clock::now();
+
+  cooldown.record(first, now, 5.0, 0.25);
+  cooldown.record(shifted, now + std::chrono::seconds(2), 5.0, 0.25);
+
+  EXPECT_EQ(cooldown.size(), 1u);
+  EXPECT_TRUE(cooldown.contains(
+      shifted, now + std::chrono::seconds(6), 0.25));
+  EXPECT_FALSE(cooldown.contains(
+      shifted, now + std::chrono::seconds(8), 0.25));
+}
