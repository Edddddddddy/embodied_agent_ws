+void Explore::publishStatus(const std::string& status,
+                            const std::string& completion_reason)
+{
+  if (status != current_status_ || !completion_reason.empty()) {
+    completion_reason_ = completion_reason;
+  }
+  current_status_ = status;
+  auto message = explore_lite_msgs::msg::ExploreStatus();
+  message.status = current_status_;
+  message.detected_frontier_count = detected_frontier_count_;
+  message.available_frontier_count = available_frontier_count_;
+  message.blacklisted_frontier_count = frontier_blacklist_.size();
+  message.active_goal_count = goal_active_ ? 1 : 0;
+  message.active_goal_id =
+      goal_active_ && active_goal_id_ != rclcpp_action::GoalUUID{}
+          ? rclcpp_action::to_string(active_goal_id_)
+          : "";
+  message.accepted_goal_count = accepted_goal_count_;
+  message.succeeded_goal_count = succeeded_goal_count_;
+  message.aborted_goal_count = aborted_goal_count_;
+  message.canceled_goal_count = canceled_goal_count_;
+  message.rejected_goal_count = rejected_goal_count_;
+  message.last_goal_terminal = last_goal_terminal_;
+  message.completion_reason = completion_reason_;
+  status_pub_->publish(message);
+}
+
 }  // namespace explore
 
