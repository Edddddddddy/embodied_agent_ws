diff --git a/explore/include/explore/frontier_attempt_memory.h b/explore/include/explore/frontier_attempt_memory.h
new file mode 100644
index 0000000000000000000000000000000000000000..258e331953bd27ccda18878aca1b48f8e4fb0cab
--- /dev/null
+++ b/explore/include/explore/frontier_attempt_memory.h
@@ -0,0 +1,203 @@
+#ifndef EXPLORE_FRONTIER_ATTEMPT_MEMORY_H_
+#define EXPLORE_FRONTIER_ATTEMPT_MEMORY_H_
+
+#include <geometry_msgs/msg/point.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <stdexcept>
+#include <vector>
+
+namespace explore
+{
+
+struct FrontierGoalKey
+{
+  geometry_msgs::msg::Point identity;
+  geometry_msgs::msg::Point approach;
+};
+
+struct FrontierAttemptClassification
+{
+  bool visited_approach{false};
+  bool failed_identity{false};
+  bool failed_approach{false};
+
+  bool selectable() const
+  {
+    return !visited_approach && !failed_identity && !failed_approach;
+  }
+};
+
+struct FrontierAttemptSummary
+{
+  std::size_t raw_candidate_count{0};
+  std::size_t selectable_count{0};
+  std::size_t suppressed_count{0};
+  std::size_t visited_approach_count{0};
+  std::size_t active_failed_identity_count{0};
+  std::size_t active_failed_approach_count{0};
+  std::size_t active_failed_candidate_count{0};
+
+  bool allCandidatesSuppressed() const
+  {
+    return raw_candidate_count > 0 && selectable_count == 0;
+  }
+};
+
+/**
+ * @brief 单次建图 epoch 内的 frontier 尝试记忆。
+ *
+ * 该模块刻意不持有时钟：成功和失败记录在当前 epoch 内都不会因等待而失效。
+ * 新建图会话必须显式调用 resetEpoch()，避免“等一会再重试”造成死循环。
+ */
+class FrontierAttemptMemory
+{
+public:
+  FrontierAttemptMemory(double identity_tolerance_m,
+                        double approach_tolerance_m)
+    : identity_tolerance_m_(identity_tolerance_m)
+    , approach_tolerance_m_(approach_tolerance_m)
+  {
+    if (!validTolerance(identity_tolerance_m_) ||
+        !validTolerance(approach_tolerance_m_)) {
+      throw std::invalid_argument(
+          "frontier attempt tolerances must be finite and positive");
+    }
+  }
+
+  void recordSucceeded(const FrontierGoalKey& goal)
+  {
+    // frontier centroid 会随地图边界更新而漂移；成功只记住真正执行过的
+    // approach，既避免换 identity 后重复到达同一点，也允许同一 identity
+    // 在出现明显不同的新 approach 时继续扩图。
+    appendUnique(
+        visited_approaches_, goal.approach, approach_tolerance_m_);
+    // timeout/cancel 与 Nav2 terminal 可能交错；若迟到结果证明目标实际成功，
+    // 成功事实必须撤销同一目标的失败记忆，否则下个 epoch 会被伪黑名单污染。
+    eraseNear(failed_identities_, goal.identity, identity_tolerance_m_);
+    eraseNear(failed_approaches_, goal.approach, approach_tolerance_m_);
+  }
+
+  void recordFailed(const FrontierGoalKey& goal)
+  {
+    // 失败同时从“未知边界身份”和“实际导航落点”两个维度记忆：任一维度
+    // 重现都可能复现同一个不可达/卡死问题，因此当前 epoch 内都要抑制。
+    appendUnique(
+        failed_identities_, goal.identity, identity_tolerance_m_);
+    appendUnique(
+        failed_approaches_, goal.approach, approach_tolerance_m_);
+  }
+
+  FrontierAttemptClassification classify(const FrontierGoalKey& goal) const
+  {
+    FrontierAttemptClassification result;
+    result.visited_approach = containsNear(
+        visited_approaches_, goal.approach, approach_tolerance_m_);
+    result.failed_identity = containsNear(
+        failed_identities_, goal.identity, identity_tolerance_m_);
+    result.failed_approach = containsNear(
+        failed_approaches_, goal.approach, approach_tolerance_m_);
+    return result;
+  }
+
+  bool isSelectable(const FrontierGoalKey& goal) const
+  {
+    return classify(goal).selectable();
+  }
+
+  FrontierAttemptSummary summarizeCurrent(
+      const std::vector<FrontierGoalKey>& raw_frontiers) const
+  {
+    FrontierAttemptSummary summary;
+    summary.raw_candidate_count = raw_frontiers.size();
+    for (const auto& frontier : raw_frontiers) {
+      const auto classification = classify(frontier);
+      if (classification.selectable()) {
+        ++summary.selectable_count;
+      } else {
+        ++summary.suppressed_count;
+      }
+      if (classification.visited_approach) {
+        ++summary.visited_approach_count;
+      }
+      if (classification.failed_identity) {
+        ++summary.active_failed_identity_count;
+      }
+      if (classification.failed_approach) {
+        ++summary.active_failed_approach_count;
+      }
+      if (classification.failed_identity || classification.failed_approach) {
+        ++summary.active_failed_candidate_count;
+      }
+    }
+    // 统计只与“当前仍存在的 raw frontier”求交。历史记录即使仍保留，
+    // frontier 已从地图消失后也不能伪造 active failure 或 blocked 结论。
+    return summary;
+  }
+
+  void resetEpoch()
+  {
+    visited_approaches_.clear();
+    failed_identities_.clear();
+    failed_approaches_.clear();
+  }
+
+private:
+  static bool validTolerance(double tolerance_m)
+  {
+    return std::isfinite(tolerance_m) && tolerance_m > 0.0;
+  }
+
+  static bool near(const geometry_msgs::msg::Point& left,
+                   const geometry_msgs::msg::Point& right,
+                   double tolerance_m)
+  {
+    return std::hypot(left.x - right.x, left.y - right.y) <= tolerance_m;
+  }
+
+  static bool containsNear(
+      const std::vector<geometry_msgs::msg::Point>& entries,
+      const geometry_msgs::msg::Point& point, double tolerance_m)
+  {
+    for (const auto& entry : entries) {
+      if (near(entry, point, tolerance_m)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  static void appendUnique(
+      std::vector<geometry_msgs::msg::Point>& entries,
+      const geometry_msgs::msg::Point& point, double tolerance_m)
+  {
+    if (!containsNear(entries, point, tolerance_m)) {
+      entries.push_back(point);
+    }
+  }
+
+  static void eraseNear(
+      std::vector<geometry_msgs::msg::Point>& entries,
+      const geometry_msgs::msg::Point& point, double tolerance_m)
+  {
+    entries.erase(
+        std::remove_if(
+            entries.begin(), entries.end(),
+            [&point, tolerance_m](const geometry_msgs::msg::Point& entry) {
+              return near(entry, point, tolerance_m);
+            }),
+        entries.end());
+  }
+
+  double identity_tolerance_m_;
+  double approach_tolerance_m_;
+  std::vector<geometry_msgs::msg::Point> visited_approaches_;
+  std::vector<geometry_msgs::msg::Point> failed_identities_;
+  std::vector<geometry_msgs::msg::Point> failed_approaches_;
+};
+
+}  // namespace explore
+
+#endif  // EXPLORE_FRONTIER_ATTEMPT_MEMORY_H_
