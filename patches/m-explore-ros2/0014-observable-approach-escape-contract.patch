+TEST(ProgressTimeoutCircuitBreaker, realEscapeBetweenTimeoutsBreaksStreak)
+{
+  explore::ProgressTimeoutCircuitBreaker breaker(2);
+  ASSERT_FALSE(breaker.observeTerminal(
+      explore::ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT, false));
+  EXPECT_EQ(breaker.consecutiveTimeouts(), 1u);
+
+  // 新目标累计移动足以离开上次卡点，即使末段再次超时也不是“连续静止”。
+  EXPECT_FALSE(breaker.observeTerminal(
+      explore::ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT, false,
+      true));
+  EXPECT_EQ(breaker.consecutiveTimeouts(), 0u);
+
+  EXPECT_FALSE(breaker.observeTerminal(
+      explore::ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT, false));
+  EXPECT_TRUE(breaker.observeTerminal(
+      explore::ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT, false));
+}
