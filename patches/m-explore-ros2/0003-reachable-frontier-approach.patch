+bool FrontierSearch::selectApproach(
+    Frontier& frontier, const std::vector<bool>& reachable_flag)
+{
+  double best_distance = std::numeric_limits<double>::infinity();
+  bool found = false;
+
+  auto consider_frontier_cell =
+      [this, &frontier, &reachable_flag, &best_distance, &found](
+          const geometry_msgs::msg::Point& frontier_point) {
+        unsigned int mx, my;
+        if (!costmap_->worldToMap(
+                frontier_point.x, frontier_point.y, mx, my)) {
+          return;
+        }
+        for (unsigned int nbr :
+             nhood4(costmap_->getIndex(mx, my), *costmap_)) {
+          if (!reachable_flag[nbr] || map_[nbr] != FREE_SPACE) {
+            continue;
+          }
+          unsigned int ax, ay;
+          double wx, wy;
+          costmap_->indexToCells(nbr, ax, ay);
+          costmap_->mapToWorld(ax, ay, wx, wy);
+          const double dx = wx - frontier.centroid.x;
+          const double dy = wy - frontier.centroid.y;
+          const double distance = dx * dx + dy * dy;
+          if (distance < best_distance) {
+            best_distance = distance;
+            frontier.approach.x = wx;
+            frontier.approach.y = wy;
+            found = true;
+          }
+        }
+      };
+
+  consider_frontier_cell(frontier.initial);
+  for (const auto& point : frontier.points) {
+    consider_frontier_cell(point);
+  }
+  return found;
+}
