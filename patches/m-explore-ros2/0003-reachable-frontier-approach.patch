+TEST(FrontierSearch, navigationGoalUsesReachableFreeSpaceApproach)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      9, 7, 1.0, 0.0, 0.0, LETHAL_OBSTACLE);
+  for (unsigned int y = 1; y <= 5; ++y) {
+    for (unsigned int x = 1; x <= 3; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+    costmap.setCost(4, y, NO_INFORMATION);
+  }
+  // 这个 free pocket 在 unknown 后方，与机器人连通域隔离；approach 不能
+  // 仅凭“frontier 邻接 free”就错误选择它。
+  costmap.setCost(5, 3, NO_INFORMATION);
+  costmap.setCost(6, 3, FREE_SPACE);
+
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"));
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(1, 3, robot.x, robot.y);
+  const auto frontiers = search.searchFrom(robot);
+
+  EXPECT_TRUE(search.lastSearchValid());
+  ASSERT_FALSE(frontiers.empty());
+  for (const auto& frontier : frontiers) {
+    unsigned int centroid_x, centroid_y, approach_x, approach_y;
+    ASSERT_TRUE(costmap.worldToMap(
+        frontier.centroid.x, frontier.centroid.y, centroid_x, centroid_y));
+    ASSERT_TRUE(costmap.worldToMap(
+        frontier.approach.x, frontier.approach.y, approach_x, approach_y));
+    EXPECT_EQ(costmap.getCost(centroid_x, centroid_y), NO_INFORMATION);
+    EXPECT_EQ(costmap.getCost(approach_x, approach_y), FREE_SPACE);
+    EXPECT_LE(approach_x, 3u);
+  }
+}
+
+TEST(FrontierSearch, rejectsDisconnectedFreePocketWhenRobotCellIsNotFree)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      7, 5, 1.0, 0.0, 0.0, LETHAL_OBSTACLE);
+  costmap.setCost(4, 2, FREE_SPACE);
+  costmap.setCost(5, 2, NO_INFORMATION);
+
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"));
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(1, 2, robot.x, robot.y);
+
+  EXPECT_TRUE(search.searchFrom(robot).empty());
+  EXPECT_FALSE(search.lastSearchValid());
+}
+
+TEST(FrontierSearch, inflatedRobotCellStillFindsReachableFrontier)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      7, 5, 1.0, 0.0, 0.0, LETHAL_OBSTACLE);
+  costmap.setCost(1, 2, 120);
+  costmap.setCost(2, 2, 80);
+  costmap.setCost(3, 2, FREE_SPACE);
+  costmap.setCost(4, 2, NO_INFORMATION);
+
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"));
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(1, 2, robot.x, robot.y);
+  const auto frontiers = search.searchFrom(robot);
+
+  EXPECT_TRUE(search.lastSearchValid());
+  ASSERT_FALSE(frontiers.empty());
+  unsigned int approach_x, approach_y;
+  ASSERT_TRUE(costmap.worldToMap(
+      frontiers.front().approach.x, frontiers.front().approach.y,
+      approach_x, approach_y));
+  EXPECT_EQ(costmap.getCost(approach_x, approach_y), FREE_SPACE);
+}
