+TEST(FrontierSearch, dispatchedApproachIsRecheckedAgainstLatestMap)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      16, 11, 0.1, 0.0, 0.0, LETHAL_OBSTACLE);
+  for (unsigned int y = 1; y <= 9; ++y) {
+    for (unsigned int x = 1; x <= 11; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+    costmap.setCost(12, y, NO_INFORMATION);
+  }
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"),
+      0.22, 1.5);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(3, 5, robot.x, robot.y);
+  const auto frontiers = search.searchFrom(robot);
+  const auto frontier = std::find_if(
+      frontiers.begin(), frontiers.end(),
+      [](const auto& item) { return item.has_approach; });
+  ASSERT_NE(frontier, frontiers.end());
+  ASSERT_TRUE(search.isApproachSafe(frontier->approach));
+
+  unsigned int x, y;
+  ASSERT_TRUE(costmap.worldToMap(
+      frontier->approach.x, frontier->approach.y, x, y));
+  costmap.setCost(x, y, NO_INFORMATION);
+  EXPECT_FALSE(search.isApproachSafe(frontier->approach));
+}
