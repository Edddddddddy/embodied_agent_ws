+TEST(ActiveFrontierGoalPolicy, holdsGoalDuringValidDetour)
+{
+  geometry_msgs::msg::Point robot;
+  geometry_msgs::msg::Point target;
+  target.x = 6.0;
+  robot.x = -1.0;
+
+  // 局部避障可能先让欧氏距离增加；在 progress_timeout 前，新的 frontier
+  // 排序不能抢占一个仍由 Nav2 正常执行的 Action。
+  const auto decision = explore::evaluateActiveFrontierGoal(
+      robot, target, 6.0, 12.0, 45.0, true, false, 0.02);
+
+  EXPECT_FALSE(decision.made_progress);
+  EXPECT_EQ(
+      decision.release_reason,
+      explore::ActiveFrontierGoalReleaseReason::NONE);
+  EXPECT_TRUE(decision.shouldHold());
+}
+
+TEST(ActiveFrontierGoalPolicy, releasesOnlyAfterProgressTimeout)
+{
+  geometry_msgs::msg::Point robot;
+  geometry_msgs::msg::Point target;
+  target.x = 6.0;
+  robot.x = 1.0;
+
+  const auto progressing = explore::evaluateActiveFrontierGoal(
+      robot, target, 6.0, 10.0, 45.0, true, false, 0.02);
+  EXPECT_TRUE(progressing.made_progress);
+  EXPECT_TRUE(progressing.shouldHold());
+
+  const auto stalled = explore::evaluateActiveFrontierGoal(
+      robot, target, 5.0, 46.0, 45.0, true, false, 0.02);
+  EXPECT_EQ(
+      stalled.release_reason,
+      explore::ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT);
+  EXPECT_FALSE(stalled.shouldHold());
+}
+
+TEST(ActiveFrontierGoalPolicy, unsafeOrBlacklistedGoalReleasesImmediately)
+{
+  geometry_msgs::msg::Point robot;
+  geometry_msgs::msg::Point target;
+  target.x = 2.0;
+
+  const auto unsafe = explore::evaluateActiveFrontierGoal(
+      robot, target, 2.0, 1.0, 45.0, false, false, 0.02);
+  EXPECT_EQ(
+      unsafe.release_reason,
+      explore::ActiveFrontierGoalReleaseReason::UNSAFE_TARGET);
+  EXPECT_FALSE(unsafe.shouldHold());
+
+  const auto blacklisted = explore::evaluateActiveFrontierGoal(
+      robot, target, 2.0, 1.0, 45.0, true, true, 0.02);
+  EXPECT_EQ(
+      blacklisted.release_reason,
+      explore::ActiveFrontierGoalReleaseReason::BLACKLISTED_IDENTITY);
+  EXPECT_FALSE(blacklisted.shouldHold());
+}
+
+TEST(ActiveFrontierGoalPolicy, subEpsilonJitterDoesNotRefreshProgress)
