+bool FrontierSearch::isApproachSafe(
+    const geometry_msgs::msg::Point& approach)
+{
+  std::lock_guard<nav2_costmap_2d::Costmap2D::mutex_t> lock(
+      *(costmap_->getMutex()));
+  unsigned int cell_x, cell_y;
+  if (!costmap_->worldToMap(approach.x, approach.y, cell_x, cell_y)) {
+    return false;
+  }
+  map_ = costmap_->getCharMap();
+  size_x_ = costmap_->getSizeInCellsX();
+  size_y_ = costmap_->getSizeInCellsY();
+  const unsigned int index = costmap_->getIndex(cell_x, cell_y);
+  return map_[index] == FREE_SPACE && approachCellHasClearance(index);
+}
