+#ifndef EXPLORE_ACTIVE_FRONTIER_GOAL_POLICY_H_
+#define EXPLORE_ACTIVE_FRONTIER_GOAL_POLICY_H_
+
+#include <geometry_msgs/msg/point.hpp>
+
+#include <cmath>
+
+namespace explore
+{
+
+enum class ActiveFrontierGoalReleaseReason
+{
+  NONE,
+  PROGRESS_TIMEOUT,
+  UNSAFE_TARGET,
+  BLACKLISTED_IDENTITY,
+};
+
+struct ActiveFrontierGoalDecision
+{
+  double distance_m{0.0};
+  bool made_progress{false};
+  ActiveFrontierGoalReleaseReason release_reason{
+      ActiveFrontierGoalReleaseReason::NONE};
+
+  bool shouldHold() const {
+    return release_reason == ActiveFrontierGoalReleaseReason::NONE;
+  }
+};
+
+/**
+ * @brief Decide whether an accepted Nav2 frontier goal keeps ownership.
+ *
+ * Map updates may reorder or split frontiers while Nav2 is following a valid
+ * detour.  Selection changes are therefore not cancellation evidence: only a
+ * terminal Action result or the existing progress timeout releases ownership.
+ */
+inline ActiveFrontierGoalDecision evaluateActiveFrontierGoal(
+    const geometry_msgs::msg::Point& robot,
+    const geometry_msgs::msg::Point& target,
+    double previous_distance_m,
+    double seconds_since_progress,
+    double progress_timeout_s,
+    bool target_safe,
+    bool identity_blacklisted,
+    double progress_epsilon_m = 0.01)
+{
+  const double distance = std::hypot(robot.x - target.x, robot.y - target.y);
+  ActiveFrontierGoalReleaseReason reason =
+      ActiveFrontierGoalReleaseReason::NONE;
+  if (!target_safe) {
+    reason = ActiveFrontierGoalReleaseReason::UNSAFE_TARGET;
+  } else if (identity_blacklisted) {
+    reason = ActiveFrontierGoalReleaseReason::BLACKLISTED_IDENTITY;
+  } else if (seconds_since_progress > progress_timeout_s) {
+    reason = ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT;
+  }
+  return ActiveFrontierGoalDecision{
+      distance,
+      distance + progress_epsilon_m < previous_distance_m,
+      reason};
+}
+
+}  // namespace explore
+
+#endif  // EXPLORE_ACTIVE_FRONTIER_GOAL_POLICY_H_
