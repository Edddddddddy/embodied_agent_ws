diff --git a/explore/include/explore/frontier_goal_lifecycle.h b/explore/include/explore/frontier_goal_lifecycle.h
new file mode 100644
index 0000000..1275b26
--- /dev/null
+++ b/explore/include/explore/frontier_goal_lifecycle.h
@@ -0,0 +1,173 @@
+#ifndef EXPLORE_FRONTIER_GOAL_LIFECYCLE_H_
+#define EXPLORE_FRONTIER_GOAL_LIFECYCLE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <unordered_set>
+
+namespace explore
+{
+
+enum class FrontierGoalState
+{
+  IDLE,
+  REQUESTING,
+  ACTIVE,
+  CANCELING,
+};
+
+struct FrontierGoalResponseEffects
+{
+  bool accepted_new{false};
+  bool rejected{false};
+  bool owns_execution{false};
+  bool cancel_accepted{false};
+};
+
+struct FrontierGoalCancelEffects
+{
+  bool state_changed{false};
+  bool cancel_active{false};
+  std::string active_uuid;
+};
+
+struct FrontierGoalResultEffects
+{
+  bool terminal_new{false};
+  bool was_owner{false};
+  bool was_canceling{false};
+};
+
+/**
+ * @brief Pure state machine for the asynchronous NavigateToPose lifecycle.
+ *
+ * Explore owns policy (which frontier and why); this class owns protocol
+ * ordering.  In particular, cancellation is not complete when the request is
+ * sent: a new goal may be dispatched only after the accepted UUID reaches a
+ * terminal result.  The split keeps ROS callbacks thin and makes late
+ * accepted/duplicate result interleavings deterministic in unit tests.
+ */
+class FrontierGoalLifecycle
+{
+public:
+  uint64_t beginDispatch()
+  {
+    if (!canDispatch()) {
+      throw std::logic_error(
+          "frontier goal dispatch requires a fully drained lifecycle");
+    }
+    state_ = FrontierGoalState::REQUESTING;
+    cancel_on_accept_ = false;
+    owner_uuid_.clear();
+    return ++request_token_;
+  }
+
+  FrontierGoalResponseEffects onResponse(
+      uint64_t token, const std::string& accepted_uuid)
+  {
+    const bool current_request = token == request_token_;
+    if (accepted_uuid.empty()) {
+      if (!current_request) {
+        // 过期 response 不能结算当前 REQUESTING。虽然 Action 协议正常情况下
+        // 每个请求只响应一次，这层防御可避免异常/重复回调误放行下一次派发。
+        return FrontierGoalResponseEffects{};
+      }
+      const bool settles_current = current_request &&
+          (state_ == FrontierGoalState::REQUESTING ||
+           (state_ == FrontierGoalState::CANCELING && owner_uuid_.empty()));
+      if (settles_current) {
+        state_ = FrontierGoalState::IDLE;
+        cancel_on_accept_ = false;
+      }
+      return FrontierGoalResponseEffects{false, true, false, false};
+    }
+
+    const bool accepted_new = accepted_goal_ids_.insert(accepted_uuid).second;
+    if (!accepted_new) {
+      return FrontierGoalResponseEffects{};
+    }
+    if (current_request && state_ == FrontierGoalState::REQUESTING &&
+        !cancel_on_accept_) {
+      owner_uuid_ = accepted_uuid;
+      state_ = FrontierGoalState::ACTIVE;
+      return FrontierGoalResponseEffects{true, false, true, false};
+    }
+
+    // stop/timeout 可能先于 goal response。即使此 UUID 已失去策略所有权，
+    // 也必须先登记 accepted，再 cancel 并等待 terminal，才能保持账本守恒。
+    if (current_request && state_ == FrontierGoalState::CANCELING &&
+        owner_uuid_.empty()) {
+      owner_uuid_ = accepted_uuid;
+    }
+    return FrontierGoalResponseEffects{true, false, false, true};
+  }
+
+  FrontierGoalCancelEffects requestCancel()
+  {
+    if (state_ == FrontierGoalState::REQUESTING) {
+      state_ = FrontierGoalState::CANCELING;
+      cancel_on_accept_ = true;
+      return FrontierGoalCancelEffects{true, false, ""};
+    }
+    if (state_ == FrontierGoalState::ACTIVE) {
+      state_ = FrontierGoalState::CANCELING;
+      return FrontierGoalCancelEffects{true, true, owner_uuid_};
+    }
+    return FrontierGoalCancelEffects{};
+  }
+
+  FrontierGoalResultEffects onResult(const std::string& uuid)
+  {
+    if (accepted_goal_ids_.count(uuid) == 0 ||
+        !terminal_goal_ids_.insert(uuid).second) {
+      return FrontierGoalResultEffects{};
+    }
+    const bool was_owner = uuid == owner_uuid_;
+    const bool was_canceling =
+        was_owner && state_ == FrontierGoalState::CANCELING;
+    if (was_owner) {
+      owner_uuid_.clear();
+      cancel_on_accept_ = false;
+      state_ = FrontierGoalState::IDLE;
+    }
+    return FrontierGoalResultEffects{true, was_owner, was_canceling};
+  }
+
+  bool canDispatch() const
+  {
+    return state_ == FrontierGoalState::IDLE && activeAcceptedCount() == 0;
+  }
+
+  FrontierGoalState state() const { return state_; }
+  bool isActiveOwner() const { return state_ == FrontierGoalState::ACTIVE; }
+  bool isCanceling() const { return state_ == FrontierGoalState::CANCELING; }
+  const std::string& ownerUuid() const { return owner_uuid_; }
+  std::size_t acceptedCount() const { return accepted_goal_ids_.size(); }
+  std::size_t terminalCount() const { return terminal_goal_ids_.size(); }
+  std::size_t activeAcceptedCount() const
+  {
+    return accepted_goal_ids_.size() - terminal_goal_ids_.size();
+  }
+  bool ledgerInvariantHolds() const
+  {
+    // terminal 只能由已登记 accepted 的 UUID 产生；把这个关系暴露给测试和
+    // 运行时审计，能及早发现 late-response/result 交错造成的账本失衡。
+    return terminal_goal_ids_.size() <= accepted_goal_ids_.size() &&
+           accepted_goal_ids_.size() ==
+               terminal_goal_ids_.size() + activeAcceptedCount();
+  }
+
+private:
+  FrontierGoalState state_{FrontierGoalState::IDLE};
+  uint64_t request_token_{0};
+  bool cancel_on_accept_{false};
+  std::string owner_uuid_;
+  std::unordered_set<std::string> accepted_goal_ids_;
+  std::unordered_set<std::string> terminal_goal_ids_;
+};
+
+}  // namespace explore
+
+#endif  // EXPLORE_FRONTIER_GOAL_LIFECYCLE_H_
