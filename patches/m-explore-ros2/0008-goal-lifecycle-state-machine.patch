+TEST(FrontierGoalLifecycle, acceptedGoalOwnsUntilExactlyOneTerminal)
+{
+  explore::FrontierGoalLifecycle lifecycle;
+  const auto token = lifecycle.beginDispatch();
+  const auto response = lifecycle.onResponse(token, "goal-a");
+
+  EXPECT_TRUE(response.accepted_new);
+  EXPECT_TRUE(response.owns_execution);
+  EXPECT_EQ(lifecycle.acceptedCount(), 1u);
+  EXPECT_EQ(lifecycle.activeAcceptedCount(), 1u);
+  EXPECT_FALSE(lifecycle.canDispatch());
+
+  const auto terminal = lifecycle.onResult("goal-a");
+  EXPECT_TRUE(terminal.terminal_new);
+  EXPECT_TRUE(terminal.was_owner);
+  EXPECT_EQ(lifecycle.terminalCount(), 1u);
+  EXPECT_EQ(lifecycle.activeAcceptedCount(), 0u);
+  EXPECT_TRUE(lifecycle.ledgerInvariantHolds());
+  EXPECT_TRUE(lifecycle.canDispatch());
+  EXPECT_FALSE(lifecycle.onResult("goal-a").terminal_new);
+}
+
+TEST(FrontierGoalLifecycle, stopBeforeResponseCountsThenCancelsLateAccepted)
+{
+  explore::FrontierGoalLifecycle lifecycle;
+  const auto token = lifecycle.beginDispatch();
+  const auto cancel = lifecycle.requestCancel();
+  EXPECT_TRUE(cancel.state_changed);
+  EXPECT_FALSE(cancel.cancel_active);
+  EXPECT_TRUE(lifecycle.isCanceling());
+
+  const auto late = lifecycle.onResponse(token, "late-goal");
+  EXPECT_TRUE(late.accepted_new);
+  EXPECT_TRUE(late.cancel_accepted);
+  EXPECT_FALSE(late.owns_execution);
+  EXPECT_EQ(lifecycle.activeAcceptedCount(), 1u);
+  EXPECT_FALSE(lifecycle.canDispatch());
+
+  const auto terminal = lifecycle.onResult("late-goal");
+  EXPECT_TRUE(terminal.was_canceling);
+  EXPECT_EQ(lifecycle.acceptedCount(), lifecycle.terminalCount());
+  EXPECT_TRUE(lifecycle.ledgerInvariantHolds());
+  EXPECT_TRUE(lifecycle.canDispatch());
+}
+
+TEST(FrontierGoalLifecycle, cancelActiveWaitsForTerminalBeforeHandoff)
+{
+  explore::FrontierGoalLifecycle lifecycle;
+  const auto token = lifecycle.beginDispatch();
+  ASSERT_TRUE(lifecycle.onResponse(token, "goal-a").owns_execution);
+
+  const auto cancel = lifecycle.requestCancel();
+  EXPECT_TRUE(cancel.cancel_active);
+  EXPECT_EQ(cancel.active_uuid, "goal-a");
+  EXPECT_TRUE(lifecycle.isCanceling());
+  EXPECT_FALSE(lifecycle.canDispatch());
+  EXPECT_THROW(lifecycle.beginDispatch(), std::logic_error);
+
+  const auto terminal = lifecycle.onResult("goal-a");
+  EXPECT_TRUE(terminal.was_owner);
+  EXPECT_TRUE(terminal.was_canceling);
+  EXPECT_TRUE(lifecycle.ledgerInvariantHolds());
+  EXPECT_TRUE(lifecycle.canDispatch());
+}
+
+TEST(FrontierGoalLifecycle, rejectedRequestDoesNotCreateAcceptedDebt)
+{
+  explore::FrontierGoalLifecycle lifecycle;
+  const auto token = lifecycle.beginDispatch();
+  const auto rejected = lifecycle.onResponse(token, "");
+
+  EXPECT_TRUE(rejected.rejected);
+  EXPECT_EQ(lifecycle.acceptedCount(), 0u);
+  EXPECT_EQ(lifecycle.terminalCount(), 0u);
+  EXPECT_TRUE(lifecycle.canDispatch());
+  EXPECT_FALSE(lifecycle.onResult("never-accepted").terminal_new);
+  EXPECT_TRUE(lifecycle.ledgerInvariantHolds());
+}
+
+TEST(FrontierGoalLifecycle, canceledRequestCanDrainThroughRejection)
+{
+  explore::FrontierGoalLifecycle lifecycle;
+  const auto token = lifecycle.beginDispatch();
+  ASSERT_TRUE(lifecycle.requestCancel().state_changed);
+
+  const auto rejected = lifecycle.onResponse(token, "");
+
+  EXPECT_TRUE(rejected.rejected);
+  EXPECT_TRUE(lifecycle.canDispatch());
+  EXPECT_EQ(lifecycle.acceptedCount(), 0u);
+  EXPECT_TRUE(lifecycle.ledgerInvariantHolds());
+}
+
+TEST(FrontierGoalLifecycle, staleRejectionCannotSettleCurrentRequest)
+{
+  explore::FrontierGoalLifecycle lifecycle;
+  const auto old_token = lifecycle.beginDispatch();
+  ASSERT_TRUE(lifecycle.onResponse(old_token, "").rejected);
+  const auto current_token = lifecycle.beginDispatch();
+
+  // 防御异常重复回调：旧 rejection 不能把新 REQUESTING 错误切回 IDLE。
+  const auto stale = lifecycle.onResponse(old_token, "");
+  EXPECT_FALSE(stale.rejected);
+  EXPECT_FALSE(lifecycle.canDispatch());
+  EXPECT_EQ(lifecycle.state(), explore::FrontierGoalState::REQUESTING);
+
+  ASSERT_TRUE(lifecycle.onResponse(current_token, "goal-current").owns_execution);
+  EXPECT_TRUE(lifecycle.onResult("goal-current").terminal_new);
+  EXPECT_TRUE(lifecycle.ledgerInvariantHolds());
+  EXPECT_TRUE(lifecycle.canDispatch());
+}
