+          [&goal, tolerance](const geometry_msgs::msg::Point& item) {
+            return std::abs(goal.x - item.x) < tolerance &&
+                   std::abs(goal.y - item.y) < tolerance;
+          }),
+      frontier_blacklist_.end());
+}
+
+void Explore::releaseActiveGoal(
+    ActiveFrontierGoalReleaseReason reason, bool blacklist_identity)
+{
+  if (blacklist_identity && !goalOnBlacklist(active_frontier_identity_)) {
+    frontier_blacklist_.push_back(active_frontier_identity_);
+  }
+  const auto effects = goal_lifecycle_.requestCancel();
+  if (effects.cancel_active && navigation_goal_handle_) {
+    move_base_client_->async_cancel_goal(navigation_goal_handle_);
+  }
+  RCLCPP_WARN(
+      logger_, "Active frontier goal released (reason=%d); draining UUID",
+      static_cast<int>(reason));
+  publishStatus(current_status_);
+}
