+bool FrontierSearch::approachCellHasClearance(unsigned int index) const
+{
+  if (approach_clearance_ <= 0.0) {
+    return true;
+  }
+
+  unsigned int cell_x, cell_y;
+  costmap_->indexToCells(index, cell_x, cell_y);
+  const double resolution = costmap_->getResolution();
+  const int radius_cells = static_cast<int>(
+      std::ceil((approach_clearance_ + 0.5 * resolution) / resolution));
+  for (int dy = -radius_cells; dy <= radius_cells; ++dy) {
+    for (int dx = -radius_cells; dx <= radius_cells; ++dx) {
+      // 用候选点到栅格方块边缘的距离，而不是只看 cell center；否则对角
+      // 障碍可能侵入圆形机器人 footprint，却被中心距错误判为安全。
+      const double edge_dx = std::max(
+          0.0, std::abs(dx) * resolution - 0.5 * resolution);
+      const double edge_dy = std::max(
+          0.0, std::abs(dy) * resolution - 0.5 * resolution);
+      if (std::hypot(edge_dx, edge_dy) > approach_clearance_) {
+        continue;
+      }
+      const int neighbour_x = static_cast<int>(cell_x) + dx;
+      const int neighbour_y = static_cast<int>(cell_y) + dy;
+      if (neighbour_x < 0 || neighbour_y < 0 ||
+          neighbour_x >= static_cast<int>(size_x_) ||
+          neighbour_y >= static_cast<int>(size_y_)) {
+        return false;
+      }
+      const unsigned int neighbour = costmap_->getIndex(
+          static_cast<unsigned int>(neighbour_x),
+          static_cast<unsigned int>(neighbour_y));
+      if (map_[neighbour] != FREE_SPACE) {
+        return false;
+      }
+    }
   }
-  return found;
+  return true;
 }
 
