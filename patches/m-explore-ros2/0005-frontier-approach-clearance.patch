+TEST(FrontierSearch, navigationGoalKeepsRobotRadiusClearanceFromUnknown)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      16, 11, 0.1, 0.0, 0.0, LETHAL_OBSTACLE);
+  for (unsigned int y = 1; y <= 9; ++y) {
+    for (unsigned int x = 1; x <= 11; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+    costmap.setCost(12, y, NO_INFORMATION);
+  }
+
+  // Frontier 相邻 free cell 对点机器人可达，但放入 0.22m 半径的真实机器人后
+  // 会与 unknown/障碍重叠；选点必须向已知空间退让，而不是依赖 Nav2 反复恢复。
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"), 0.22);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(3, 5, robot.x, robot.y);
+  const auto frontiers = search.searchFrom(robot);
+
+  ASSERT_FALSE(frontiers.empty());
+  for (const auto& frontier : frontiers) {
+    ASSERT_TRUE(frontier.has_approach);
+    unsigned int approach_x, approach_y;
+    ASSERT_TRUE(costmap.worldToMap(
+        frontier.approach.x, frontier.approach.y, approach_x, approach_y));
+    EXPECT_LE(approach_x, 9u);
+    EXPECT_GE(approach_y, 3u);
+    EXPECT_LE(approach_y, 7u);
+  }
+}
+
+TEST(FrontierSearch, unsafeFrontierRemainsVisibleForRecovery)
+{
+  using nav2_costmap_2d::FREE_SPACE;
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      16, 11, 0.1, 0.0, 0.0, LETHAL_OBSTACLE);
+  for (unsigned int y = 4; y <= 6; ++y) {
+    for (unsigned int x = 1; x <= 11; ++x) {
+      costmap.setCost(x, y, FREE_SPACE);
+    }
+    costmap.setCost(12, y, NO_INFORMATION);
+  }
+
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0, rclcpp::get_logger("frontier_test"),
+      0.22, 1.5);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(3, 5, robot.x, robot.y);
+  const auto frontiers = search.searchFrom(robot);
+
+  // 没有安全 approach 时仍要保留原始 frontier，让上层发布 blocked/recovery；
+  // 返回 empty 会被误解释为 no_frontiers，造成未知区域尚存却提前 PASS。
+  ASSERT_FALSE(frontiers.empty());
+  EXPECT_TRUE(std::all_of(
+      frontiers.begin(), frontiers.end(),
+      [](const auto& frontier) { return !frontier.has_approach; }));
+}
+
