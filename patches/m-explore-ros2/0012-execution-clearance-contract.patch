+TEST(FrontierSearch, quarterMetreClearanceAdmitsCriticalBlindPocket)
+{
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      64, 50, 0.05, 0.0, 0.0, LETHAL_OBSTACLE);
+  setFreeRectangle(costmap, 2, 20, 2, 47);
+  // 现场约 0.605 m 的临界盲袋在 0.05 m 栅格上表示为 12 个 cell；
+  // 0.25 m 侵蚀仍留下中心线，因此这个旧阈值会把执行点送入袋内。
+  setFreeRectangle(costmap, 21, 55, 19, 30);
+  for (unsigned int y = 19; y <= 30; ++y) {
+    costmap.setCost(56, y, NO_INFORMATION);
+  }
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0,
+      rclcpp::get_logger("frontier_critical_pocket_025"), 0.25, 1.5);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(10, 25, robot.x, robot.y);
+
+  const auto frontiers = search.searchFrom(robot);
+
+  ASSERT_FALSE(frontiers.empty());
+  EXPECT_TRUE(hasApproachAtOrBeyondX(frontiers, costmap, 21));
+}
+
+TEST(FrontierSearch, executionClearanceRejectsCriticalBlindPocket)
+{
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+  using nav2_costmap_2d::NO_INFORMATION;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      64, 50, 0.05, 0.0, 0.0, LETHAL_OBSTACLE);
+  setFreeRectangle(costmap, 2, 20, 2, 47);
+  setFreeRectangle(costmap, 21, 55, 19, 30);
+  for (unsigned int y = 19; y <= 30; ++y) {
+    costmap.setCost(56, y, NO_INFORMATION);
+  }
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0,
+      rclcpp::get_logger("frontier_critical_pocket_033"), 0.33, 1.5);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(10, 25, robot.x, robot.y);
+
+  const auto frontiers = search.searchFrom(robot);
+
+  ASSERT_FALSE(frontiers.empty());
+  EXPECT_TRUE(search.lastClearanceDomainValid());
+  // 0.33 m = 0.22 m 底盘半径 + 0.11 m 控制、栅格与定位余量。
+  // 允许退回开阔区或不给 approach，但绝不能再把目标放进临界盲袋。
+  EXPECT_FALSE(hasApproachAtOrBeyondX(frontiers, costmap, 21));
+}
+
+TEST(FrontierSearch, executionClearanceKeepsOneMetreDoorReachable)
+{
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      80, 60, 0.05, 0.0, 0.0, LETHAL_OBSTACLE);
+  // 20 个 0.05 m cell 表达 1.0 m 门洞；0.33 m 连通域侵蚀后仍应保留
+  // 可执行中心带，避免安全余量反过来阻断常规门洞。
+  configureTwoRoomPassage(costmap, 20, 39);
+  frontier_exploration::FrontierSearch search(
+      &costmap, 1.0, 0.0, 0.0,
+      rclcpp::get_logger("frontier_one_metre_door"), 0.33, 1.5);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(10, 30, robot.x, robot.y);
+
+  const auto frontiers = search.searchFrom(robot);
+
+  ASSERT_FALSE(frontiers.empty());
+  ASSERT_TRUE(search.lastClearanceDomainValid());
+  EXPECT_TRUE(hasApproachAtOrBeyondX(frontiers, costmap, 46));
+}
