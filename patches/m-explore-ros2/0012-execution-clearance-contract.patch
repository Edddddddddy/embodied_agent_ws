+TEST(FrontierSearch, fortyCentimetreClearanceOverDisconnectsUsablePassage)
+{
+  using nav2_costmap_2d::LETHAL_OBSTACLE;
+
+  nav2_costmap_2d::Costmap2D costmap(
+      80, 60, 0.05, 0.0, 0.0, LETHAL_OBSTACLE);
+  // 0.75 m 通道为 0.33 m 执行半径保留安全中心线；若错误复用只约束
+  // 终点的 0.40 m goal clearance，整条连通域会被过度侵蚀并断开。
+  configureTwoRoomPassage(costmap, 23, 37);
+  geometry_msgs::msg::Point robot;
+  costmap.mapToWorld(10, 30, robot.x, robot.y);
+  frontier_exploration::FrontierSearch execution_clearance(
+      &costmap, 1.0, 0.0, 0.0,
+      rclcpp::get_logger("frontier_passage_033"), 0.33, 1.5);
+  frontier_exploration::FrontierSearch goal_clearance_misuse(
+      &costmap, 1.0, 0.0, 0.0,
+      rclcpp::get_logger("frontier_passage_040"), 0.40, 1.5);
+
+  const auto executable = execution_clearance.searchFrom(robot);
+  const auto over_disconnected = goal_clearance_misuse.searchFrom(robot);
+
+  ASSERT_FALSE(executable.empty());
+  ASSERT_FALSE(over_disconnected.empty());
+  EXPECT_TRUE(hasApproachAtOrBeyondX(executable, costmap, 46));
+  EXPECT_FALSE(hasApproachAtOrBeyondX(over_disconnected, costmap, 46));
+}
