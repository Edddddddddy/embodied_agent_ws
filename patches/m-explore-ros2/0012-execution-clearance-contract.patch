+void setFreeRectangle(
+    nav2_costmap_2d::Costmap2D& costmap,
+    unsigned int min_x, unsigned int max_x,
+    unsigned int min_y, unsigned int max_y)
+{
+  for (unsigned int y = min_y; y <= max_y; ++y) {
+    for (unsigned int x = min_x; x <= max_x; ++x) {
+      costmap.setCost(x, y, nav2_costmap_2d::FREE_SPACE);
+    }
+  }
+}
+
+bool hasApproachAtOrBeyondX(
+    const std::vector<frontier_exploration::Frontier>& frontiers,
+    nav2_costmap_2d::Costmap2D& costmap, unsigned int minimum_x)
+{
+  return std::any_of(
+      frontiers.begin(), frontiers.end(),
+      [&costmap, minimum_x](const auto& frontier) {
+        if (!frontier.has_approach) {
+          return false;
+        }
+        unsigned int x, y;
+        return costmap.worldToMap(
+            frontier.approach.x, frontier.approach.y, x, y) &&
+            x >= minimum_x;
+      });
+}
+
+void configureTwoRoomPassage(
+    nav2_costmap_2d::Costmap2D& costmap,
+    unsigned int passage_min_y, unsigned int passage_max_y)
+{
+  setFreeRectangle(costmap, 2, 25, 2, 57);
+  setFreeRectangle(costmap, 46, 70, 2, 57);
+  setFreeRectangle(costmap, 26, 45, passage_min_y, passage_max_y);
+  for (unsigned int y = 2; y <= 57; ++y) {
+    costmap.setCost(71, y, nav2_costmap_2d::NO_INFORMATION);
+  }
+}
