+class ProgressTimeoutCircuitBreaker
+{
+public:
+  explicit ProgressTimeoutCircuitBreaker(std::size_t limit) : limit_(limit)
+  {
+    if (limit_ == 0) {
+      throw std::invalid_argument(
+          "progress timeout circuit-breaker limit must be positive");
