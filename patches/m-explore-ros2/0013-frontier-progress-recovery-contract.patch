+  bool observeTerminal(
+      ActiveFrontierGoalReleaseReason requested_release,
+      bool terminal_succeeded)
+  {
+    if (terminal_succeeded ||
+        requested_release !=
+            ActiveFrontierGoalReleaseReason::PROGRESS_TIMEOUT) {
+      consecutive_timeouts_ = 0;
+      return false;
+    }
+    ++consecutive_timeouts_;
+    return consecutive_timeouts_ >= limit_;
+  }
